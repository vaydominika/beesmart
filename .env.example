# Database and Auth.js
DATABASE_URL=mysql://user:password@127.0.0.1:3306/beesmart
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_URL=https://beesmart.example.com

# Optional Google sign-in; configure both or neither
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI generation and moderation
DEEPSEEK_API_KEY=
MODERATION_TIMEOUT_MS=15000

# Persistent private uploads and mandatory production malware scanning
UPLOAD_STORAGE_DIR=/var/lib/beesmart/uploads
MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# Application controls
ADMIN_EMAILS=owner@example.com
NEXT_PUBLIC_EARLY_ACCESS_FEEDBACK_ENABLED=false
